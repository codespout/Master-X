# Copy this file to `.env` and adjust the values for your server.
#   cp .env.example .env
# The file is read automatically on startup (repo root or server/).

# Port the app listens on (one port serves the API + built frontend + WebSocket).
PORT=3001

# Set NODE_ENV=production to serve the built client from client/dist.
# This is the default when the variable is unset.
NODE_ENV=production

# Critical: generate a strong secret and DO NOT reuse the default.
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Initial administrator account (created automatically on first start).
ADMIN_EMAIL=admin@masterx.io
ADMIN_PASSWORD=change-this-admin-password

# Optional: override where the SQLite database and KYC proof uploads are stored.
# DB_PATH=/var/lib/masterx/masterx.db
# UPLOAD_DIR=/var/lib/masterx/uploads
